{
  "name": "nekumi",
  "version": "1.0.0",
  "main": "dist/index.js",
  "license": "MIT",
  "description": "nekumi | Bot designed by @astrvon",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint . --ext .ts --max-warnings=0 --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": "npm run format",
    "*.ts": "npm run lint",
    "*": "npm run build"
  },
  "dependencies": {
    "@vercel/node": "^5.1.16",
    "argon2": "^0.44.0",
    "axios": "^1.15.2",
    "dayjs": "^1.11.20",
    "discord-interactions": "^4.3.0",
    "discord.js": "^14.19.3",
    "dotenv": "^16.5.0",
    "lodash": "^4.18.1",
    "node-vibrant": "4.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/convert-units": "^2.3.12",
    "@types/node": "^25.6.0",
    "@types/node-fetch": "^2.6.13",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.8.3",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.32.1"
  },
  "engines": {
    "node": ">=16.9.0"
  }
}
